
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privateroom - Secure Storage</title>
    <!-- Tailwind CSS CDN for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">

    <div class="bg-gray-800 p-8 rounded-2xl shadow-2xl max-w-md w-full text-center border border-gray-700">
        <h1 class="text-3xl font-bold mb-4 text-indigo-400">Privateroom</h1>
        <p class="text-gray-300 mb-6 text-sm leading-relaxed">
            Safely store your photos, videos, and important files. Access them anytime, anywhere with your secure login.
        </p>

        <!-- Action Buttons -->
        <div class="space-y-4">
            <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl transition duration-200">
                Login / Sign Up
            </button>
            <button class="w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2.5 rounded-xl transition duration-200">
                Upload Files
            </button>
        </div>

        <div class="mt-6 text-xs text-gray-500">
            &copy; 2026 Privateroom. All rights reserved.
        </div>
    </div>

</body>
</html>
