<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SafeVault | Secure Storage</title>
  <style>
    :root{
      --bg-dark:#07111f;
      --bg-soft:#0f1d32;
      --panel:#101f35;
      --panel-2:#132744;
      --primary:#60a5fa;
      --secondary:#22c55e;
      --accent:#8b5cf6;
      --danger:#ef4444;
      --text:#edf6ff;
      --muted:#9cb5cf;
      --line:rgba(255,255,255,0.08);
      --shadow:0 20px 50px rgba(0,0,0,0.35);
      --radius:24px;
    }

    *{ box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body{
      margin:0;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background:radial-gradient(circle at top, #122b47 0%, #07111f 45%, #030a12 100%);
      color:var(--text);
      min-height:100vh;
    }

    a{ color:inherit; text-decoration:none; }
    img{ max-width:100%; display:block; }

    .container{
      width:min(1200px, 92%);
      margin:0 auto;
    }

    header{
      position:sticky;
      top:0;
      z-index:20;
      backdrop-filter: blur(12px);
      background:rgba(8, 16, 28, 0.7);
      border-bottom:1px solid var(--line);
    }

    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      min-height:80px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:14px;
      font-weight:700;
      letter-spacing:0.5px;
    }

    .brand-mark{
      width:42px; height:42px; border-radius:14px;
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      display:grid; place-items:center;
      font-weight:900; color:#031522;
      box-shadow:0 12px 28px rgba(96,165,250,0.35);
    }

    .nav-links{
      display:flex;
      gap:28px;
      color:var(--muted);
      font-size:0.95rem;
    }

    .nav-actions{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .btn{
      border:none;
      border-radius:12px;
      padding:12px 18px;
      font-weight:600;
      cursor:pointer;
      transition:0.25s ease;
    }

    .btn:hover{ transform:translateY(-1px); }

    .btn-outline{
      background:transparent;
      color:var(--text);
      border:1px solid var(--line);
    }

    .btn-primary{
      background:linear-gradient(135deg, var(--primary), #3b82f6);
      color:#041722;
      box-shadow:0 10px 22px rgba(59,130,246,0.35);
    }

    .hero{
      padding:50px 0 30px;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.1fr 0.9fr;
      gap:26px;
      align-items:center;
    }

    .hero-copy h1{
      margin:0 0 18px;
      font-size:clamp(2.5rem, 3vw, 4.3rem);
      line-height:1.05;
      letter-spacing:-0.06em;
    }

    .hero-copy h1 .highlight{
      background:linear-gradient(135deg, #8b5cf6, #60a5fa, #22c55e);
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
    }

    .hero-copy p{
      color:var(--muted);
      font-size:1.08rem;
      line-height:1.7;
      max-width:620px;
      margin:0 0 26px;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-bottom:22px;
    }

    .mini-stats{
      display:flex;
      gap:18px;
      flex-wrap:wrap;
      color:var(--muted);
      font-size:0.9rem;
    }

    .mini-stats span{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:10px 14px;
      background:rgba(255,255,255,0.02);
      border:1px solid var(--line);
      border-radius:12px;
    }

    .stat-dot{
      width:10px; height:10px; border-radius:50%;
      background:var(--secondary);
      box-shadow:0 0 12px rgba(34,197,94,0.8);
    }

    .hero-card{
      background:linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:22px;
    }

    .user-card{
      background:linear-gradient(180deg, rgba(15,29,50,0.92), rgba(20,40,66,0.82));
      border:1px solid var(--line);
      border-radius:20px;
      padding:18px;
      position:relative;
      overflow:hidden;
    }

    .user-card::before{
      content:"";
      position:absolute;
      inset:-60% 30% auto auto;
      width:180px; height:180px;
      background:radial-gradient(circle, rgba(96,165,250,0.38), transparent 60%);
      filter:blur(14px);
    }

    .user-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:20px;
      position:relative; z-index:1;
    }

    .user-pill{
      background:rgba(34,197,94,0.16);
      color:#a7f3d0;
      border:1px solid rgba(34,197,94,0.25);
      border-radius:999px;
      padding:7px 12px;
      font-size:0.76rem;
      font-weight:700;
